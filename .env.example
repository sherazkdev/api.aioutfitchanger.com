# MongoDB (local: mongodb://127.0.0.1:27017/ai_wardrobe)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_wardrobe
MONGODB_MAX_POOL_SIZE=25
CONTENT_CACHE_TTL_SECONDS=60
BFL_POLL_MIN_INTERVAL_MS=1500
USER_AUTH_CACHE_MS=30000

# JWT (access ~10m via ACCESS_TOKEN_TTL_SECONDS; each secret must be 32+ chars)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google Sign-In — server accepts native Google id_tokens (aud = one of these clients)
# and Firebase Auth id_tokens from Google sign-in (verified via FIREBASE_* below).
# Firebase Android Google sign-in also needs the Web client ID here (Firebase console → Authentication → Google → Web SDK configuration).
GOOGLE_CLIENT_ID_ANDROID=your_android_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# Admin bootstrap (first login or: npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# BFL / FLUX (try-on proxy — later routes)
BFL_API_KEY=your_bfl_api_key_here
BFL_API_BASE=https://api.bfl.ai

# Try-on provider (default bfl). byteplus = beauty FLUX path only (Phase 1 experimental).
TRY_ON_PROVIDER=bfl
ARK_API_KEY=your_byteplus_api_key_here
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_MODEL=dola-seedream-5-0-flash-260915

# Firebase Admin (FCM only — service account JSON as single line or path)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"

# Firebase gateway auth (mobile X-API-Key + X-Firebase-Uid)
FIREBASE_GATEWAY_AUTH_ENABLED=1
GATEWAY_API_KEY_MASTER_KEY=replace_with_master_key_at_least_32_chars
GATEWAY_API_KEY_GRACE_SECONDS=1800

# App
NODE_ENV=development
# Local: http://localhost:3000 | Production: https://appworkspro.com
APP_URL=http://localhost:3000

# Admin UI: set to 1 to enable design preview (mock KPIs/charts) on admin pages
NEXT_PUBLIC_ADMIN_DESIGN_PREVIEW=0

# Production: set to 1 to skip demo catalog/home/onboarding auto-seed (Emerald Shalwar placeholders)
DISABLE_CONTENT_SEED=0

# Background poll for scheduled push campaigns (ms, min 15000)
BROADCAST_SCHEDULER_INTERVAL_MS=60000
RESET_TOKEN_TTL_HOURS=1
# Mobile app: 4-digit OTP (hashed in DB; separate from web link token)
RESET_OTP_TTL_MINUTES=10
RESET_OTP_MAX_ATTEMPTS=5
# Optional extra pepper for OTP hashing (defaults to JWT_REFRESH_SECRET)
# RESET_OTP_PEPPER=
# Password reset email (Resend — server only; verify domain in Resend dashboard)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Outfit Changer
# Optional: shown in email footer
# SUPPORT_EMAIL=support@aioutfitchanger.com
# Optional: https://appworkspro.com/reset-password (defaults to APP_URL/reset-password)
RESET_PASSWORD_URL=
# Optional: https://appworkspro.com/verify-email (defaults to APP_URL/verify-email)
# VERIFY_EMAIL_URL=
API_RATE_LIMIT_AUTH_PER_MIN=20

# Security (optional — see docs/API_SECURITY_HARDENING.md)
# REDIS_URL=redis://127.0.0.1:6379
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.2
# API_CORS_ORIGINS=https://appworkspro.com
# API_MAX_BODY_BYTES=18874368
# ENFORCE_TURNSTILE=true
# TURNSTILE_SECRET_KEY=

# Try-on daily limits per UTC day (0 = unlimited). Plan: free / premium / admin (unlimited).
TRY_ON_DAILY_LIMIT_FREE=5
TRY_ON_DAILY_LIMIT_PREMIUM=50
# Legacy flat cap when FREE/PREMIUM vars unset:
# TRY_ON_DAILY_LIMIT_PER_USER=5
# TRY_ON_MODERATION_ENABLED=true
# Google Cloud Vision SafeSearch (ADC / GOOGLE_APPLICATION_CREDENTIALS on server only)
IMAGE_SAFETY_MODERATION_ENABLED=1
IMAGE_SAFETY_FAIL_CLOSED=1
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/vision-sa.json
# AI result watermark for free users (1/default on, 0=off globally)
# TRY_ON_WATERMARK_ENABLED=1

# Localization (self-hosted LibreTranslate — free, no per-char billing)
# docker run -p 5000:5000 libretranslate/libretranslate
LIBRETRANSLATE_URL=http://127.0.0.1:5000
DEFAULT_SOURCE_LOCALE=en
